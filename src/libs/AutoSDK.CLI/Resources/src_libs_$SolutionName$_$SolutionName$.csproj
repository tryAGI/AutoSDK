<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Generated/AutoSDK.SharedJsonMetadata.props" Condition="Exists('Generated/AutoSDK.SharedJsonMetadata.props')" />
  <ItemGroup Condition="'$(AutoSDKJsonMetadataVersion)' != ''">
    <PackageReference Include="AutoSDK.JsonMetadata" Version="$(AutoSDKJsonMetadataVersion)" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>C# SDK based on $SolutionName$ OpenAPI specification.</Description>
    <PackageTags>api;client;sdk;dotnet;swagger;openapi;specification;generated;nswag</PackageTags>
  </PropertyGroup>

</Project>
